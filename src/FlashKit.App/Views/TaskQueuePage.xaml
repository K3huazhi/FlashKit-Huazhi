<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.TaskQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    xmlns:models="using:FlashKit.Core.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Loc Key=TaskQueuePage}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:Loc Key=TaskQueueSubtitle}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.TypeFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
                MinWidth="0" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{x:Bind ViewModel.StatusFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                MinWidth="0" />
            <ComboBox
                Grid.Column="2"
                ItemsSource="{x:Bind ViewModel.TimeFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedTime, Mode=TwoWay}"
                MinWidth="0" />
            <ComboBox
                Grid.Column="3"
                ItemsSource="{x:Bind ViewModel.SerialFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedSerial, Mode=TwoWay}"
                MinWidth="0" />
            <Button Grid.Column="4" Content="{loc:Loc Key=TaskClearCompleted}" Click="ClearCompleted_Click" MinWidth="96" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                ItemsSource="{x:Bind ViewModel.Tasks}"
                SelectionMode="None"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:OperationTaskRecord">
                        <Grid Padding="10,7" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind TypeText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    <TextBlock
                                        Text="{x:Bind StatusText}"
                                        Foreground="{x:Bind Status, Converter={StaticResource TaskStatusToBrush}}"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Serial}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind CreatedText}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind ProgressText}" Style="{StaticResource CaptionTextStyle}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind OutputText}" Style="{StaticResource CaptionTextStyle}" MaxWidth="380" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind OutputText}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind Error}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind Error, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="{loc:Loc Key=TaskOpenLog}" Click="OpenLog_Click" MinWidth="72" />
                                <Button Content="{loc:Loc Key=TaskOpenOutput}" Click="OpenOutput_Click" MinWidth="72" />
                                <Button
                                    Content="{loc:Loc Key=TaskCancel}"
                                    Click="Cancel_Click"
                                    MinWidth="72" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                Style="{StaticResource CaptionTextStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasTasks, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <TextBlock
            Grid.Row="3"
            Text="{loc:Loc Key=TaskQueueFootnote}"
            Style="{StaticResource CaptionTextStyle}" />
    </Grid>
</Page>
