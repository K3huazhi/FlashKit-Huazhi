<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.PackagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    xmlns:vm="using:FlashKit.App.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16,20,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=L105}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="{loc:Loc Key=L106}"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Loc Key=L107}" Command="{x:Bind ViewModel.RefreshKnownPartitionsCommand}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" MaxWidth="1280" HorizontalAlignment="Stretch">
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Title="{loc:Loc Key=L108}"
                    Message="{loc:Loc Key=L109}" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Title="{loc:Loc Key=L110}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc Key=L111}" Style="{StaticResource SectionTitleStyle}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.PackagePath, Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="{loc:Loc Key=L113}"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=L114}" Click="SelectPackage_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L116}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ExtractOutputPreview, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                        </StackPanel>

                        <ProgressBar
                            Value="{x:Bind ViewModel.ExtractProgress, Mode=OneWay}"
                            Maximum="100"
                            Visibility="{x:Bind ViewModel.IsExtracting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.ExtractStatus, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExtractProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc Key=L117}" Command="{x:Bind ViewModel.CancelExtractCommand}" />
                            <Button Grid.Column="2" Content="{loc:Loc Key=L118}" Command="{x:Bind ViewModel.OpenExtractOutputCommand}" />
                            <Button
                                Grid.Column="3"
                                Content="{loc:Loc Key=L115}"
                                Style="{StaticResource AccentActionButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanExtract, Mode=OneWay}"
                                Click="StartExtract_Click" />
                        </Grid>

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasIncrementalWarning, Mode=OneWay}"
                            Severity="Error"
                            Title="{loc:Loc Key=L119}"
                            Message="{x:Bind ViewModel.IncrementalWarning, Mode=OneWay}"
                            IsClosable="False" />

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasExtractWarnings, Mode=OneWay}"
                            Severity="Informational"
                            Title="{loc:Loc Key=L120}"
                            Message="{x:Bind ViewModel.ExtractWarnings, Mode=OneWay}"
                            IsClosable="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Loc Key=L122}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.KnownPartitionsHint, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc Key=L123}" Click="AddImages_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            <Button Grid.Column="2" Content="{loc:Loc Key=L096}" Command="{x:Bind ViewModel.ClearImagesCommand}" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.PackSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />

                        <ListView
                            ItemsSource="{x:Bind ViewModel.Images}"
                            SelectionMode="None"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            MaxHeight="260"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PackImageViewModel">
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FilePath}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{x:Bind PartitionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:Loc Key=L124}"
                                            FontFamily="Cascadia Mono, Consolas"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind StatusText}"
                                            Foreground="{x:Bind IsVerified, Converter={StaticResource BoolToBrush}}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind StatusDetail}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="{loc:Loc Key=L087}" Click="RemoveImage_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasPackValidationError, Mode=OneWay}"
                            Severity="Error"
                            Title="{loc:Loc Key=L125}"
                            Message="{x:Bind ViewModel.PackValidationText, Mode=OneWay}"
                            IsClosable="False" />

                        <InfoBar
                            IsOpen="{x:Bind ViewModel.HasPackWarnings, Mode=OneWay}"
                            Severity="Warning"
                            Title="{loc:Loc Key=L126}"
                            Message="{x:Bind ViewModel.PackWarningsText, Mode=OneWay}"
                            IsClosable="False" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.PackOutputPath, Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="{loc:Loc Key=L127}"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=L128}" Click="ChooseOutput_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                        </Grid>

                        <ProgressBar
                            Value="{x:Bind ViewModel.PackProgress, Mode=OneWay}"
                            Maximum="100"
                            Visibility="{x:Bind ViewModel.IsPacking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.PackStatus, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.PackResultText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc Key=L117}" Command="{x:Bind ViewModel.CancelPackCommand}" />
                            <Button Grid.Column="2" Content="{loc:Loc Key=L118}" Command="{x:Bind ViewModel.OpenPackOutputCommand}" />
                            <Button
                                Grid.Column="3"
                                Content="{loc:Loc Key=L129}"
                                Style="{StaticResource AccentActionButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanPack, Mode=OneWay}"
                                Click="StartPack_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
