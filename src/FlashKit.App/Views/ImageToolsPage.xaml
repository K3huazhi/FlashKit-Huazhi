<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.ImageToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Loc Key=ImageToolsPage}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:Loc Key=ImageToolsSubtitle}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=ImageOperation}" VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.Operations}"
                                SelectedIndex="{x:Bind ViewModel.SelectedOperationIndex, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay}"
                                PlaceholderText="{loc:Loc Key=ImageChooseSource}"
                                IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=ImageChooseSource}" Click="ChooseSource_Click" MinWidth="96" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                PlaceholderText="{x:Bind ViewModel.OutputHint, Mode=OneWay}"
                                IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=ImageChooseOutput}" Click="ChooseOutput_Click" MinWidth="96" />
                        </Grid>

                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsHash, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=ImageExpectedHash}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.ExpectedHash, Mode=TwoWay}" PlaceholderText="可选：粘贴 MD5 或 SHA256" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                    Severity="Success"
                    Title="{loc:Loc Key=ImageResult}"
                    IsClosable="False">
                    <InfoBar.Content>
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </InfoBar.Content>
                </InfoBar>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Key=ImageOpenOutput}" Click="OpenOutput_Click" MinWidth="96" />
                    <Button
                        Content="{loc:Loc Key=ImageStart}"
                        Click="Start_Click"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                        Style="{StaticResource AccentActionButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
