<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    xmlns:vm="using:FlashKit.App.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=L099}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="{loc:Loc Key=L100}"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
            <ToggleSwitch Grid.Column="2" Header="{loc:Loc Key=L101}" IsOn="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:Loc Key=L102}" Command="{x:Bind ViewModel.CopyAllCommand}" />
                <Button Content="{loc:Loc Key=L096}" Command="{x:Bind ViewModel.ClearCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ContentCardStyle}" Padding="0">
                <ListView
                    x:Name="LogList"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryViewModel">
                            <Grid Padding="8,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Category}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{x:Bind Kind, Converter={StaticResource LogKindToBrush}}" />
                                    <TextBlock Text="{x:Bind Preview}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ExitText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ContentCardStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=L103}" Style="{StaticResource SectionTitleStyle}" />
                        <Button Grid.Column="1" Content="{loc:Loc Key=L104}" Command="{x:Bind ViewModel.CopySelectedCommand}" />
                    </Grid>
                    <TextBox
                        Grid.Row="1"
                        Text="{x:Bind ViewModel.SelectedDetailText, Mode=OneWay}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

