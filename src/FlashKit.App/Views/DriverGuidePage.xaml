<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.DriverGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" MaxWidth="960" HorizontalAlignment="Left">
            <Button Content="{loc:Loc Key=L036}" Click="Back_Click" HorizontalAlignment="Left" />
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=L037}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="{loc:Loc Key=L038}"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Title="{loc:Loc Key=L039}"
                Message="{loc:Loc Key=L040}" />

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc Key=L041}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Key=L042}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Key=L043}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Key=L044}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Key=L045}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Key=L046}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc Key=L047}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Key=L048}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Key=L049}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Loc Key=L050}" Click="OpenDeviceManager_Click" />
                        <Button Content="{loc:Loc Key=L051}" Click="OpenGoogleDriver_Click" Style="{StaticResource AccentActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Loc Key=L052}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{loc:Loc Key=L053}" Style="{StaticResource CaptionTextStyle}" />
                    <Grid ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="{loc:Loc Key=L054}" Click="OpenSamsung_Click" />
                        <Button Grid.Row="0" Grid.Column="1" Content="{loc:Loc Key=L055}" Click="OpenXiaomi_Click" />
                        <Button Grid.Row="0" Grid.Column="2" Content="{loc:Loc Key=L056}" Click="OpenOppo_Click" />
                        <Button Grid.Row="1" Grid.Column="0" Content="vivo / iQOO" Click="OpenVivo_Click" />
                        <Button Grid.Row="1" Grid.Column="1" Content="{loc:Loc Key=L057}" Click="OpenHuawei_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="{loc:Loc Key=L058}"
                Message="{loc:Loc Key=L059}" />
        </StackPanel>
    </ScrollViewer>
</Page>

