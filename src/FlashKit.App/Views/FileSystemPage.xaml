<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.FileSystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Loc Key=FileSystemPage}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:Loc Key=FileSystemSubtitle}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=FileSystemOperation}" VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.Operations}"
                                SelectedIndex="{x:Bind ViewModel.OperationIndex, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                        </Grid>

                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsPack, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=FileSystemPackFormat}" VerticalAlignment="Center" />
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.PackFormats}"
                                SelectedItem="{x:Bind ViewModel.SelectedPackFormat, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay}"
                                PlaceholderText="{loc:Loc Key=FileSystemChooseSource}"
                                IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=FileSystemChooseSource}" Click="ChooseSource_Click" MinWidth="120" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                PlaceholderText="{x:Bind ViewModel.OutputHint, Mode=OneWay}"
                                IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{loc:Loc Key=FileSystemChooseOutput}" Click="ChooseOutput_Click" MinWidth="120" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SourceFormatText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CapabilitiesText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Title="{loc:Loc Key=FileSystemError}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="False" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                    Severity="Success"
                    Title="{loc:Loc Key=FileSystemResult}"
                    Message="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                    IsClosable="False" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Key=FileSystemOpenOutput}" Click="OpenOutput_Click" MinWidth="120" />
                    <Button
                        Content="{loc:Loc Key=FileSystemStart}"
                        Click="Start_Click"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                        Style="{StaticResource AccentActionButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
