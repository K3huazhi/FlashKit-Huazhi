<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FlashKit.App.Localization"
    xmlns:models="using:FlashKit.Core.Models"
    NavigationCacheMode="Required"
    Background="Transparent">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Key=L007}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="{loc:Loc Key=L131}"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L132}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ToolchainSummary, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:Loc Key=L133}" Command="{x:Bind ViewModel.OpenToolsFolderCommand}" />
                        <Button Grid.Column="2" Content="{loc:Loc Key=L134}" Command="{x:Bind ViewModel.RecheckCommand}" Style="{StaticResource AccentActionButtonStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ToolInfoItem">
                                <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind VersionText}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ExecutablePath}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind ErrorText}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind ErrorText, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind ViewModel.CheckedAtText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L135}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DriverSummary, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Loc Key=L050}" Click="OpenDeviceManager_Click" />
                            <Button Content="{loc:Loc Key=L037}" Click="OpenDriverGuide_Click" Style="{StaticResource AccentActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind ViewModel.DriverDetails, Mode=OneWay}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{loc:Loc Key=L136}"
                        Style="{StaticResource CaptionTextStyle}" />
                    <Button Content="{loc:Loc Key=L137}" Command="{x:Bind ViewModel.OpenGoogleDriverCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc Key=L138}" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="32" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Loc Key=L139}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AppVersion}" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc Key=L140}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.RuntimeText}" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc Key=L141}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ToolsDirectory}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="{loc:Loc Key=L142}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Key=L143}" TextWrapping="Wrap" />
                    </Grid>
                    <Button Content="{loc:Loc Key=L144}" Command="{x:Bind ViewModel.OpenLogFolderCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc Key=L145}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="{loc:Loc Key=L146}"
                        TextWrapping="Wrap"
                        Style="{StaticResource PageSubtitleStyle}" />
                    <TextBlock
                        Text="{loc:Loc Key=L147}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

