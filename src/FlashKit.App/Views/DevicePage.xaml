<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FlashKit.App.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FlashKit.Core.Models"
    xmlns:loc="using:FlashKit.App.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc Key=DeviceInfo}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock
                        Text="{loc:Loc Key=L011}"
                        Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="{loc:Loc Key=L012}"
                    Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                    VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            MinWidth="240"
                            ItemsSource="{x:Bind ViewModel.Devices}"
                            SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                            PlaceholderText="{loc:Loc Key=L014}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AndroidDevice">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            Text="{x:Bind ModeText}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="130">
                            <TextBlock Text="{loc:Loc Key=L015}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" MinWidth="90">
                            <TextBlock Text="{loc:Loc Key=L016}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc Key=L031}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.AutoRefresh, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                        <ComboBox Grid.Column="3" MinWidth="80" SelectedIndex="{x:Bind ViewModel.RefreshIntervalIndex, Mode=TwoWay}" VerticalAlignment="Center">
                            <ComboBoxItem Content="{loc:Loc Key=L032}" />
                            <ComboBoxItem Content="{loc:Loc Key=L033}" />
                        </ComboBox>
                        <Button Grid.Column="4" Content="{loc:Loc Key=L034}" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AccentActionButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.SelectionHint, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="{loc:Loc Key=L017}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="False" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasDriverWarning, Mode=OneWay}"
                Severity="Warning"
                Title="{loc:Loc Key=L018}"
                Message="{x:Bind ViewModel.DriverWarning, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{loc:Loc Key=L019}" Click="OpenDriverGuide_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource InverseBool}}"
                Severity="Informational"
                Title="{loc:Loc Key=L020}"
                Message="{x:Bind ViewModel.UnavailableMessage, Mode=OneWay}"
                IsClosable="False" />

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=DeviceOverview}" Style="{StaticResource SectionTitleStyle}" />
                        <ProgressRing
                            Grid.Column="1"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Width="20"
                            Height="20" />
                    </Grid>

                    <Grid
                        ColumnSpacing="40"
                        RowSpacing="12"
                        Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L021}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ModelText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L022}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ManufacturerText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L023}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.AndroidVersionText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="SDK / API" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SdkText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L024}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CpuAbiText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L025}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CodenameText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Build ID" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.BuildIdText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                            <TextBlock Text="{loc:Loc Key=L015}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Text="{x:Bind ViewModel.UnavailableCardText, Mode=OneWay}"
                        Style="{StaticResource PageSubtitleStyle}"
                        Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc Key=L026}" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                            <ProgressBar Value="{x:Bind ViewModel.BatteryPercent, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{x:Bind ViewModel.BatterySecondary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.UnavailableCardText, Mode=OneWay}"
                            Style="{StaticResource PageSubtitleStyle}"
                            Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc Key=L027}" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{loc:Loc Key=L028}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.UnavailableCardText, Mode=OneWay}"
                            Style="{StaticResource PageSubtitleStyle}"
                            Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ContentCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Loc Key=L029}" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar Value="{x:Bind ViewModel.StoragePercent, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{x:Bind ViewModel.StorageMountText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.UnavailableCardText, Mode=OneWay}"
                            Style="{StaticResource PageSubtitleStyle}"
                            Visibility="{x:Bind ViewModel.IsInfoAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                Severity="Informational"
                Title="{loc:Loc Key=L035}"
                Message="{x:Bind ViewModel.WarningsText, Mode=OneWay}"
                IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
